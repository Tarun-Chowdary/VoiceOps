# --- Gnani speech (the only speech service allowed). One key covers STT and TTS. Never commit the real .env ---
GNANI_API_KEY=
GNANI_STT_FORMAT=transcribe      # measured better than "verbatim": spoken numbers and dates arrive as digits (en-IN / hi-IN)
GNANI_TTS_MODEL=timbre-v2.5      # timbre-v3.0 exists only in newer SDK versions
# Optional per-language agent voices (v2.5 catalog): English Kaveri / Trupti / Pranav / Shlok, Hindi Nalini / Deepak, Hinglish Poorvi
# GNANI_TTS_VOICE_EN=Kaveri
# GNANI_TTS_VOICE_HI=Nalini
# GNANI_TTS_VOICE_HINGLISH=Poorvi
# GNANI_TTS_LANG_HINGLISH=auto   # newer SDKs accept "hi-en"; older ones need "auto"

# --- LLM: any OpenAI-compatible API. Default setup = Gemini through its OpenAI-compatible endpoint ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_RPM=12                   # requests per minute we allow ourselves (free Gemini tier: 12-15; raise for paid keys; 0 = off)
DEMO_MAX_TURNS_PER_MIN=8         # per-visitor limit in the demo app

# --- Data: point to the extracted organizer dataset (not copied into this repo) ---
DATASET_DIR=./dataset/Capstone_Project_Dataset_FTTT_2026
